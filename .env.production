# Production Environment Configuration

# Node Environment
NODE_ENV=production

# API Configuration
API_PORT=8081
API_HOST=0.0.0.0

# CORS Configuration
CORS_ORIGIN=http://localhost

# Logging
LOG_LEVEL=info

# Production specific
DEBUG=false

# Security
TRUST_PROXY=true

# Docker Hub Images
DOCKER_HUB_USERNAME=kzamanbd
API_IMAGE=kzamanbd/web-terminal-api:latest
CLIENT_IMAGE=kzamanbd/web-terminal-client:latest
