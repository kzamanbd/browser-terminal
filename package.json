{
    "name": "kzamanbd/terminal",
    "version": "1.0.3",
    "description": "This is a full stack application with react and node",
    "engines": {
        "node": ">=18"
    },
    "packageManager": "pnpm@10.10.0",
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "lint": "turbo lint",
        "format": "prettier --write \"**/*.{ts,tsx}\"",
        "docker:build": "./scripts/docker-build-push.sh",
        "docker:up": "docker-compose up -d --build",
        "docker:down": "docker-compose down"
    },
    "keywords": [
        "react",
        "node",
        "express",
        "socket.io"
    ],
    "author": "Kamruzzaman",
    "license": "MIT",
    "devDependencies": {
        "prettier": "^3.6.2",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "turbo": "^2.5.8",
        "typescript": "^5.9.2"
    }
}

